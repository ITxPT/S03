</td></tr>

<tr>
<td>=E2=80=9CEVD=E2=80=9D
</td>
<td>Fault duration
</td>
<td>[mandatory]
</td></tr>

<tr>
<td>=E2=80=9CFOD=E2=80=9D
</td>
<td>Distance driven while fault pending
</td>
<td>[recommended if applicable]
</td></tr></tbody></table>
