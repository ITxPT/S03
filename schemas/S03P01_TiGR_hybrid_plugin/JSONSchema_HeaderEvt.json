{
  "$id": "JSONSchema_HeaderEvt.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "The Root Schema of Header only event",
  "description": "ITxPT S03P01 TiGR Protocol - Header only event JSON Schema",
  "required": [
    "Header"
  ],  
  "properties": {
    "Header": {
      "type": "object",
      "title": "The Header Schema",
      "required": [
        "ID",
        "VERS",
        "SERVERNAME",
        "VIN",
        "PROG",
        "EVTDATE",
        "TRSDATE",
        "SRVDATE",
        "SENDDATE",
        "CODE",
        "TYPE",
        "DST",
        "GPSInfo"
      ],
      "properties": {
        "CODE": {
          "$ref": "JSONSchema_Codes.json#/properties/CODE"
        },
        "DST": {
          "$ref": "JSONSchema_Codes.json#/properties/DST"
        },
        "EVTDATE": {
          "$ref": "JSONSchema_Codes.json#/properties/EVTDATE"
        },
        "TRSDATE": {
          "$ref": "JSONSchema_Codes.json#/properties/TRSDATE"
        },
        "GPSInfo": {
          "type": "object",
          "title": "The Gpsinfo Schema",
          "required": [
            "LAT",
            "LON",
            "ALT"         
          ],
          "properties": {
            "ALT": {
              "$ref": "JSONSchema_Codes.json#/properties/ALT"
            },
            "DOP": {
              "$ref": "JSONSchema_Codes.json#/properties/DOP"
            },
            "GNSSType": {
              "$ref": "JSONSchema_Codes.json#/properties/GNSSType"
            },
            "HEAD": {
              "$ref": "JSONSchema_Codes.json#/properties/HEAD"
            },
            "LAT": {
              "$ref": "JSONSchema_Codes.json#/properties/LAT"
            },
            "LON": {
              "$ref": "JSONSchema_Codes.json#/properties/LON"
            },
            "NUMSAT": {
              "$ref": "JSONSchema_Codes.json#/properties/NUMSAT"
            }
          }
        },
        "ID": {
          "$ref": "JSONSchema_Codes.json#/properties/ID"
        },
        "PROG": {
          "$ref": "JSONSchema_Codes.json#/properties/PROG"
        },
        "SENDDATE": {
          "$ref": "JSONSchema_Codes.json#/properties/SENDDATE"
        },
        "SERVERNAME": {
          "$ref": "JSONSchema_Codes.json#/properties/SERVERNAME"
        },
        "SRVDATE": {
          "$ref": "JSONSchema_Codes.json#/properties/SRVDATE"
        },
        "TIMEZONE": {
          "$ref": "JSONSchema_Codes.json#/properties/TIMEZONE"
        },
        "TYPE": {
          "$ref": "JSONSchema_Codes.json#/properties/TYPE"
        },
        "VIN": {
          "$ref": "JSONSchema_Codes.json#/properties/VIN"
        },
        "VERS": {
          "$ref": "JSONSchema_Codes.json#/properties/VERS"
        },
        "BID": {
          "$ref": "JSONSchema_Codes.json#/properties/BID"
        }
      }
    }
  }
}
